# ── AURA environment variables ────────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Your OpenAI API key (used for planning, extraction, synthesis, embeddings).
# Without it AURA still starts, but the LLM-backed phases fall back to
# heuristics and no new knowledge can be extracted.
OPENAI_API_KEY=

# ── Optional API keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# ── LLM settings ──────────────────────────────────────────────────────────────
AURA_LLM_MODEL=gpt-4o
AURA_LLM_TEMPERATURE=0.1
AURA_EMBEDDING_MODEL=text-embedding-3-small
AURA_EMBEDDING_DIMENSIONS=1536

# ── Agent behaviour ───────────────────────────────────────────────────────────
AURA_ENV=development
AURA_LOG_LEVEL=INFO
AURA_CYCLE_INTERVAL_MINUTES=60
AURA_MAX_PAPERS_PER_CYCLE=50
AURA_API_PORT=8080
AURA_REPORTS_DIR=./reports

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aura:aura_password@localhost:5432/aura
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aura_neo4j_password
REDIS_URL=redis://localhost:6379/0

# Credentials used by docker-compose to create the PostgreSQL container
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_password
POSTGRES_DB=aura

# ── Publishing (optional) ─────────────────────────────────────────────────────
AURA_GITHUB_TOKEN=
AURA_GITHUB_REPO=

# ── Security ──────────────────────────────────────────────────────────────────
AURA_SECRET_KEY=change-me-in-production
AURA_ENCRYPTION_KEY=change-me-in-production
